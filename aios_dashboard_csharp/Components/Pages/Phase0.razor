@page "/phase0"
@inject IDatabaseService DatabaseService
@inject ILogger<Phase0> Logger
@rendermode InteractiveServer

<PageTitle>Phase 0: Setup & Connection Test</PageTitle>

<h1>System integrity</h1>
<p class="page-sub">Read from <code>investment_platform.db</code> via a read-only connection. Nothing here can change your data.</p>

<div class="row mb-4">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5><svg class="ico"><use href="/icons/_sprite.svg#i-database"/></svg>&nbsp;Database Information</h5>
            </div>
            <div class="card-body">
                <p><strong>Database Path:</strong> <code>@DbPath</code></p>
                <p><strong>Exists:</strong> @FileExists</p>
                @if (FileExists)
                {
                    <p><strong>Size:</strong> @FileSize MB</p>
                }
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5><svg class="ico"><use href="/icons/_sprite.svg#i-terminal"/></svg>&nbsp;Connection Test</h5>
            </div>
            <div class="card-body">
                <button class="btn btn-primary w-100" @onclick="TestConnection" disabled="@IsTesting">
                    @if (IsTesting)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span><text>Testing</text>
                    }
                    else
                    {
                        <span>🔄 Test Connection</span>
                    }
                </button>
                @if (ConnectionTestResult != null)
                {
                    <div class="mt-3">
                        @if (ConnectionTestResult.Value)
                        {
                            <div class="alert alert-success">✅ Connection successful! SELECT 1 = 1</div>
                        }
                        else
                        {
                            <div class="alert alert-danger">❌ Connection failed</div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">
        <h5><svg class="ico"><use href="/icons/_sprite.svg#i-book-open"/></svg>&nbsp;Database Tables</h5>
    </div>
    <div class="card-body">
        @if (Tables.Count > 0)
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Table Name</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var table in Tables)
                    {
                        <tr>
                            <td>@table</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-warning">No tables found or connection failed</div>
        }
    </div>
</div>

@code {
    private const string DbPath = @"F:\My Son\data\investment_platform.db";
    private bool FileExists => System.IO.File.Exists(DbPath);
    private double FileSize => FileExists ? Math.Round(new System.IO.FileInfo(DbPath).Length / (1024.0 * 1024.0), 2) : 0;
    private bool IsTesting = false;
    private bool? ConnectionTestResult = null;
    private List<string> Tables = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadTablesAsync();
    }

    private async Task TestConnection()
    {
        IsTesting = true;
        ConnectionTestResult = null;
        StateHasChanged();

        ConnectionTestResult = await DatabaseService.TestConnectionAsync();
        
        IsTesting = false;
        StateHasChanged();
    }

    private async Task LoadTablesAsync()
    {
        if (!FileExists) return;

        try
        {
            using var connection = new Microsoft.Data.Sqlite.SqliteConnection($"Data Source={DbPath};Mode=ReadOnly");
            await connection.OpenAsync();
            using var command = connection.CreateCommand();
            command.CommandText = "SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%' ORDER BY name";
            using var reader = await command.ExecuteReaderAsync();
            while (await reader.ReadAsync())
            {
                Tables.Add(reader.GetString(0));
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[phase0] LoadTablesAsync failed");
        }
    }
}