    <div class="fac-cards">
      <figure class="fac-card inview"><img id="facImg1" alt="Gradien abstrak merepresentasikan data bursa" loading="lazy"><figcaption class="fac-caption clay"><div style="font-size:.875rem;font-weight:500">70 Ranking</div><div style="font-size:.65rem;opacity:.85">Skor 38 MEDIUM — bullish trend, undervalued, quality strong. Belum ada HIGH.</div></figcaption></figure>
      <figure class="fac-card inview"><img id="facImg2" alt="Gradien abstrak merepresentasikan sentimen berita" loading="lazy"><figcaption class="fac-caption blue"><div style="font-size:.875rem;font-weight:500">5 Keputusan</div><div style="font-size:.65rem;opacity:.85">2 POLICY_BLOCKED tanpa risk param · 3 SUCCESS dengan entry/stop/target.</div></figcaption></figure>
