        </div>
        <img id="memberImg" alt="Simbol AIOS Atrium" loading="lazy">
      </article>
    </div>
  </div>
</section>
<section id="trust"><canvas id="constellationTrust" aria-hidden="true"></canvas>
  <div class="trust-top">
    <div class="percent-badge inview"><div><div style="font-size:1.5rem;font-weight:500">24/7</div><div style="font-size:.6rem;color:#595959;max-width:7em;margin:.25rem auto 0">Narasi dibaca ulang tiap ada perubahan</div></div></div>
    <article class="trust-card inview"><div style="background:#fff;border-radius:.75rem;padding:.5rem 1rem;font-size:1.25rem;font-weight:500;align-self:flex-start">#01</div><div><div style="font-size:1.125rem;font-weight:500">Dipercaya buat baca kondisi harian</div><p style="font-size:.75rem;color:#595959;line-height:1.6;margin-top:.5rem">Dari pemula sampai trader aktif, AIOS dipakai buat nangkep konteks sebelum ambil keputusan — bukan gantiin keputusannya.</p></div></article>
  </div>
  <h2 class="ghost-heading" id="ghostHeading"></h2>
  <figure class="coach-figure inview" id="coachFigure"><img id="coachImg" alt=""><figcaption class="coach-caption"><div style="font-size:.875rem;font-weight:500" id="coachName"></div><div style="font-size:.65rem;opacity:.8" id="coachRole"></div></figcaption></figure>
  <div class="orbit-wrap" id="orbitWrap" aria-hidden="true"></div>
  <div class="trust-controls">
    <button class="arrow-btn outline" id="trustPrev" aria-label="Previous"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
    <div class="dots" id="trustDots"></div>
    <button class="arrow-btn solid" id="trustNext" aria-label="Next"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
  </div>
</section>
