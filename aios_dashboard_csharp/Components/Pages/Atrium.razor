  </header>
  <div class="hero-title-wrap"><h1 id="hero-title"></h1></div>
  <div class="hero-bottom">
    <p class="hero-tagline" id="hero-tagline"><span class="clip"><span>Baca Pasar,</span></span><br><span class="clip"><span>Bukan Tebak</span></span></p>
    <div class="hero-right">
      <div class="collection-slider inview" id="collectionSlider">
        <div class="collection-card" id="collectionCard"></div>
        <div class="dots" id="collectionDots"></div>
      </div>
      <article class="membership-card inview" id="membershipCard">
