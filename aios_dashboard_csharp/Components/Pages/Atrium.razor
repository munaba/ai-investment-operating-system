<div id="modal" aria-hidden="true" inert>
  <div class="modal-backdrop" id="modalBackdrop"></div>
  <div class="modal-panel" role="dialog" aria-modal="true" aria-label="Book a visit">
    <div class="modal-head"><div><div class="eyebrow dark"><span class="dot"></span> Atur notifikasi</div><h2 style="margin-top:.75rem;font-size:1.875rem;font-weight:500;line-height:.95;letter-spacing:-.02em" id="modalTitle"><span class="clip"><span>Kabari aku</span></span><br><span class="clip"><span>kalau ada apa-apa</span></span></h2></div><button class="menu-close" id="modalClose" aria-label="Close" style="background:#f4f4f4;color:#0a0a0a"><svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div>
    <form id="contactForm" novalidate>
      <div class="field"><label for="f-name">Nama</label><input id="f-name" name="name" type="text" placeholder="Alex Rivera" autocomplete="name"></div>
      <div class="field"><label for="f-email">Email</label><input id="f-email" name="email" type="email" placeholder="kamu@email.com" autocomplete="email"></div>
      <div class="field"><label for="f-msg">Aset apa yang mau dipantau?</label><textarea id="f-msg" name="msg" rows="3" placeholder="Contoh: BBCA, TLKM, ASII — kabari kalau ada perubahan tensi atau arus modal…"></textarea></div>
      <button type="submit" class="modal-submit" id="modalSubmit"><span class="shimmer-glare" aria-hidden="true"></span>Aktifkan notifikasi</button>
    </form>
    <div class="success-panel" id="successPanel" style="display:none"><div style="width:3rem;height:3rem;border-radius:62.5rem;background:#2563c9;display:grid;place-items:center;margin:0 auto;color:#fff"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></div><div style="margin-top:.75rem;font-size:1.125rem;font-weight:500">Request received</div><p style="margin-top:.5rem;font-size:.875rem;color:#595959" id="successText"></p><button class="pill solid" id="successDone" style="margin-top:1rem">Done</button></div>
  </div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/atrium.js");
            await module.InvokeVoidAsync("initAtrium");
        }
    }
}
