@page "/ikhtisar"
@rendermode InteractiveServer
@layout EmptyLayout
@inject IJSRuntime JSRuntime

<PageTitle>AIOS · Ikhtisar</PageTitle>

<GateStrip />

@((MarkupString)System.IO.File.ReadAllText(System.IO.Path.Combine("wwwroot", "ikhtisar_body.html")))

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("initIkhtisar");
        }
    }
}
