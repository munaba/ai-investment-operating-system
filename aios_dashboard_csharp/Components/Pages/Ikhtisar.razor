@page "/ikhtisar"
@layout EmptyLayout

<PageTitle>AIOS · Ikhtisar</PageTitle>

@((MarkupString)System.IO.File.ReadAllText(System.IO.Path.Combine("wwwroot", "ikhtisar_body.html")))

<script src="https://cdn.jsdelivr.net/npm/lenis@1.1.20/dist/lenis.min.js"></script>
<script src="/js/ikhtisar.js"></script>
<script>
try{
  var lenis=new Lenis({duration:1.15,easing:function(t){return 1-Math.pow(1-t,3)},smoothWheel:true,smoothTouch:false});
  function raf(time){lenis.raf(time);requestAnimationFrame(raf)}
  requestAnimationFrame(raf);
  document.addEventListener('visibilitychange',function(){if(document.hidden)try{lenis.stop()}catch(e){}else try{lenis.start()}catch(e){}});
}catch(e){}
</script>
