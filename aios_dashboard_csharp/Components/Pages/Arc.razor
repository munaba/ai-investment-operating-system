@page "/arc"
@rendermode InteractiveServer
@layout EmptyLayout
@inject IJSRuntime JSRuntime

<PageTitle>AIOS · Arc</PageTitle>

<a href="#main" class="skip">Skip to content</a>
<div class="gh"></div>
<div class="gl"><div class="vl" data-tape="52"></div><div class="vl" data-tape="18"><i class="vd t"></i><i class="vd b"></i></div><div class="vl" data-tape="74"></div><div class="vl" data-tape="34"><i class="vd t"></i><i class="vd b"></i></div><div class="vl" data-tape="61"></div></div>

<header class="site-header">
    <nav class="nav-left" aria-label="Primary"><a href="/atrium">Atrium</a><a href="/atlas">Atlas</a><a href="/arc" class="active" aria-current="page">Arc</a><a href="/materi">Materi</a><a href="/jejak">Jejak</a><a href="/ikhtisar">Ikhtisar</a></nav>
    <a class="brand-center" translate="no" href="/atrium" aria-label="AIOS — beranda"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M4.8 5.6A9 9 0 0 0 4.8 18.4"/><path d="M19.2 5.6a9 9 0 0 1 0 12.8"/></svg> AIOS · Arc</a>
    <div class="nav-right"><button class="book-link" id="bookHeader">Atur Notifikasi</button><button class="burger" id="burger" aria-label="Open menu"><span class="burger-bars"><i></i><i></i></span></button></div>
  </header>

<main id="main" tabindex="-1" class="wrap">
  <section class="hero">
    <canvas id="heroGrid" aria-hidden="true"></canvas>
    <div>
      <h1 class="h1">Lintasan<br><em>delapan skenario</em></h1>
      <p class="sub">Bukan chart trading. Delapan cara membaca lintasan editorial yang sama — <b style="color:#fff;font-weight:500">5 brief · 70 titik</b> — dari pita keyakinan sampai matriks keputusan. Drag untuk orbit, scroll untuk zoom. Data hardcoded, tanpa fetch.</p>
      <div class="meta">
        <span class="chip"><i style="--ac:#d8c9b6"></i> editorial · 5 brief</span>
        <span class="chip"><b id="ticker70" style="font-weight:600">0</b> titik</span>
        <span class="chip">Three r160</span>
        <span class="chip" id="acChip"><i id="acDot"></i> <span id="acName">Pita Keyakinan</span></span>
      </div>
    </div>
    <div class="stage shine-wrap">
      <div class="shine" id="stageShine" aria-hidden="true"></div>
      <canvas id="cv" aria-label="Lintasan prediktif"></canvas>
      <div class="ov">
        <span class="chip"><i id="ovDot"></i> <span id="ovLabel">Pita · drag orbit · scroll zoom</span></span>
        <span class="chip" id="hint">70 titik · 5 brief</span>
      </div>
    </div>
  </section>

  <div class="arc-main">
  <div class="tabs" id="tabs" role="tablist" aria-label="Skenario lintasan"></div>

  <section class="info">
    <div class="card">
      <h2 id="arcTitle">—</h2>
      <p id="arcDesc">—</p>
      <div style="margin-top:10px;display:flex;gap:8px;flex-wrap:wrap">
        <span class="chip" id="arcMode">mode: —</span>
        <span class="chip" id="arcPoints">titik: 70</span>
      </div>
    </div>
    <div class="card">
      <h2>5 brief · sumber lintasan</h2>
      <div id="briefList"></div>
      <p style="margin-top:10px;color:#8b90a0;font-family:monospace;font-size:11px;letter-spacing:.04em">70 titik = jejak valuasi 14 minggu per brief. Nilai dinormalisasi −1..+1 untuk visual, bukan harga.</p>
    </div>
  </section>
  </div>

  <footer id="contact">
  <div id="ripples" aria-hidden="true"></div>
  <div class="footer-cta">
    <div><div class="eyebrow light"><span class="dot"></span> Mulai pakai</div><h2 style="margin-top:1rem"><span class="clip"><span>Siap baca</span></span><br><span class="clip"><span>pasar?</span></span></h2></div>
    <button class="pill light" id="footerCta"><span class="shimmer-glare" id="shimmerGlare" aria-hidden="true"></span>Atur Notifikasi <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
  </div>
  <div class="footer-cols">
    <div class="footer-brand"><div class="footer-brand-title" translate="no"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3" fill="currentColor" stroke="none"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3"/></svg> AIOS · Arc</div><p style="margin-top:1rem;font-size:.875rem;color:rgba(255,255,255,.65)">Bukti ditulis, rencana ditahan, alasan disimpan. Bukan sinyal.</p><address style="margin-top:1.5rem;font-style:normal;font-size:.875rem;color:rgba(255,255,255,.8)"><a href="mailto:hello@aios.app">hello@aios.app</a></address></div>
    <div><p class="mono-s" style="margin-bottom:.9rem">Halaman</p><ul style="font-size:.875rem;color:rgba(255,255,255,.7);display:grid;gap:.55rem"><li><a href="/atrium">Atrium</a></li><li><a href="/atlas">Atlas</a></li><li><a href="/materi">Materi</a></li><li><a href="/jejak">Jejak</a></li><li><a href="/ikhtisar">Ikhtisar</a></li></ul></div>
    <div><p class="mono-s" style="margin-bottom:.9rem">Data</p><ul style="font-size:.875rem;color:rgba(255,255,255,.7);display:grid;gap:.55rem"><li>70 snapshot</li><li>5 brief keputusan</li><li>1 jendela aktif</li><li>3 posisi ditutup</li></ul></div>
  </div>
  <div style="border-top:1px solid rgba(255,255,255,.15);margin-top:2.5rem;padding-top:1.5rem;display:flex;flex-wrap:wrap;gap:1rem;justify-content:space-between;font-size:.75rem;color:rgba(255,255,255,.6)"><p>© 2026 AIOS</p><p>Phase H · 24 Agt — 23 Sep 2026 · Asia/Jakarta</p></div>
</footer>
</main>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/arc.js");
            await module.InvokeVoidAsync("initArc");
        }
    }
}
