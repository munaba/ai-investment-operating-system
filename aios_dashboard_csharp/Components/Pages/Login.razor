@page "/login"
@using aios_dashboard_csharp.Services
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using System.Security.Claims
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Components.NavigationManager NavManager
@inject IHttpContextAccessor HttpContextAccessor
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedLocalStorage ProtectedLocalStorage

<div class="container" style="max-width: 420px; margin-top: 12vh;">
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h3 class="text-center mb-1" style="font-family: Fraunces, Georgia, serif; font-weight:700;">AIOS<span style="color:var(--lime)">.</span></h3>
            <p class="text-center text-muted mb-4">Akses terbatas — jaringan rumah saja</p>

            @if (loginError)
            {
                <div class="alert alert-danger py-2">Username atau password salah.</div>
            }

            <EditForm Model="model" OnValidSubmit="HandleLogin" FormName="loginForm">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label" for="username">Username</label>
                    <InputText id="username" class="form-control" @bind-Value="model.Username" autocomplete="username" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="password">Password</label>
                    <InputText id="password" type="password" class="form-control" @bind-Value="model.Password" autocomplete="current-password" />
                </div>
                <button type="submit" class="btn btn-primary w-100" disabled="@isBusy">
                    @(isBusy ? "Memproses…" : "Login")
                </button>
            </EditForm>
        </div>
    </div>
    <p class="text-center text-muted mt-3" style="font-size: 0.85em;">
        Session timeout: @(AuthService.SessionTimeoutMinutes) menit tidak aktif
    </p>
</div>

@code {
    private LoginModel model = new();
    private bool loginError;
    private bool isBusy;

    protected override void OnInitialized()
    {
        loginError = NavManager.Uri.Contains("error=1", StringComparison.OrdinalIgnoreCase);
    }

    private async Task HandleLogin()
    {
        if (isBusy) return;
        isBusy = true;
        loginError = false;

        try
        {
            if (!AuthService.ValidateCredentials(model.Username ?? string.Empty, model.Password ?? string.Empty))
            {
                loginError = true;
                isBusy = false;
                return;
            }

            var httpContext = HttpContextAccessor.HttpContext;
            if (httpContext is null)
            {
                // No HttpContext (prerender) — fall back to the SPA POST endpoint path.
                NavManager.NavigateTo("/login?error=1", forceLoad: true);
                return;
            }

            var claims = new List<Claim> { new Claim(ClaimTypes.Name, AuthService.Username) };
            var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);

            await httpContext.SignInAsync(
                CookieAuthenticationDefaults.AuthenticationScheme,
                new ClaimsPrincipal(identity),
                new AuthenticationProperties
                {
                    IsPersistent = false,
                    ExpiresUtc = DateTimeOffset.UtcNow.AddMinutes(AuthService.SessionTimeoutMinutes),
                });

            // Clear credentials from memory immediately after use.
            model.Password = string.Empty;

            NavManager.NavigateTo("/", forceLoad: true);
        }
        finally
        {
            isBusy = false;
        }
    }

    private sealed class LoginModel
    {
        public string? Username { get; set; }
        public string? Password { get; set; }
    }
}
