@page "/login"
@rendermode InteractiveServer
@using aios_dashboard_csharp.Services
@using Microsoft.JSInterop
@inject IAuthService AuthService
@inject NavigationManager NavManager
@inject IJSRuntime JS

<div class="container" style="max-width: 420px; margin-top: 12vh;">
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h3 class="text-center mb-1" style="font-family: Fraunces, Georgia, serif; font-weight:700;">AIOS<span style="color:var(--lime)">.</span></h3>
            <p class="text-center text-muted mb-4">Akses terbatas — jaringan rumah saja</p>

            @if (loginError)
            {
                <div class="alert alert-danger py-2">Username atau password salah.</div>
            }
            @if (rateLimited)
            {
                <div class="alert alert-warning py-2">Terlalu banyak percobaan — tunggu 1 menit.</div>
            }

            <EditForm Model="model" OnValidSubmit="HandleLogin" FormName="loginForm">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label" for="username">Username</label>
                    <InputText id="username" class="form-control" @bind-Value="model.Username" autocomplete="username" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="password">Password</label>
                    <InputText id="password" type="password" class="form-control" @bind-Value="model.Password" autocomplete="current-password" />
                </div>
                <button type="submit" class="btn btn-primary w-100" disabled="@isBusy">
                    @(isBusy ? "Memproses…" : "Login")
                </button>
            </EditForm>
        </div>
    </div>
    <p class="text-center text-muted mt-3" style="font-size: 0.85em;">
        Session timeout: @(AuthService.SessionTimeoutMinutes) menit tidak aktif
    </p>
</div>

@code {
    private LoginModel model = new();
    private bool loginError;
    private bool rateLimited;
    private bool isBusy;

    protected override void OnInitialized()
    {
        loginError = NavManager.Uri.Contains("error=1", StringComparison.OrdinalIgnoreCase);
    }

    private async Task HandleLogin()
    {
        if (isBusy) return;
        isBusy = true;
        loginError = false;
        rateLimited = false;

        try
        {
            // Blazor Server circuit has no HttpContext — use the verified POST endpoint
            // POST /api/auth/login sets the same HttpOnly/Lax/Secure cookie (M-09)
            // and is rate-limited (M-02). JS fetch ensures the cookie is attached
            // by the browser; forceLoad reload then sends it on the next request.
            var result = "bad";
            try
            {
                result = await JS.InvokeAsync<string>("aiosLogin", model.Username ?? string.Empty, model.Password ?? string.Empty);
            }
            catch
            {
                result = "bad";
            }

            if (result == "rate_limited")
            {
                rateLimited = true;
                return;
            }
            if (result != "ok")
            {
                loginError = true;
                return;
            }

            model.Password = string.Empty;
            NavManager.NavigateTo("/", forceLoad: true);
        }
        finally
        {
            isBusy = false;
        }
    }

    private sealed class LoginModel
    {
        public string? Username { get; set; }
        public string? Password { get; set; }
    }
}
