@page "/atlas"
@rendermode InteractiveServer
@layout EmptyLayout
@inject IJSRuntime JSRuntime

<PageTitle>AIOS · Atlas</PageTitle>

<a href="#main" class="skip">Skip to content</a>
<a href="#main" class="skip">Skip to content</a>
<header class="site-header">
    <nav class="nav-left" aria-label="Primary"><a href="/atrium">Atrium</a><a href="/atlas" class="active" aria-current="page">Atlas</a><a href="/arc">Arc</a><a href="/materi">Materi</a><a href="/jejak">Jejak</a><a href="/ikhtisar">Ikhtisar</a></nav>
    <a class="brand-center" translate="no" href="/atrium" aria-label="AIOS — beranda"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M4.8 5.6A9 9 0 0 0 4.8 18.4"/><path d="M19.2 5.6a9 9 0 0 1 0 12.8"/></svg> AIOS · Atlas</a>
    <div class="nav-right"><span class="hclock" id="clock" aria-live="off">-</span><button class="book-link" id="bookHeader">Atur Notifikasi</button><button class="burger" id="burger" aria-label="Open menu" aria-expanded="false" aria-controls="mnav"><span class="burger-bars"><i></i><i></i></span></button></div>
  </header>
<div id="mnav" inert aria-hidden="true"><div style="display:flex;justify-content:space-between;align-items:center"><b>ATLAS</b><button id="closeNav" style="border:1px solid rgba(255,255,255,.2);border-radius:9999px;padding:.4rem .8rem;font-size:.75rem">Tutup ✕</button></div><nav style="margin-top:2rem;display:flex;flex-direction:column"><a href="#hero">Peta</a><a href="#menara">Menara</a><a href="#alur">Alur</a><a href="#titik">Titik</a><a href="#tentang">Tentang</a></nav><p style="margin-top:auto;padding-top:2rem;font-size:.8rem;color:rgba(255,255,255,.5)">Peta jaringan personal - tempat · ide · orang. 42 simpul · 11 menara · 70 titik.</p></div>

<main id="main" tabindex="-1">
<section id="hero">
  <canvas id="atlasCanvas" aria-hidden="true"></canvas>
  <div class="vig"></div>
  <div class="wm">ATLAS</div>
  <div class="shell hero-grid">
    <div>
      <div class="eyebrow"><span class="dot"></span> Peta Jaringan Personal - bukan trading</div>
      <h1 class="hero">Peta yang<br/>mengingat<br/>ke mana kamu<br/>pergi.</h1>
      <p class="hero-sub">42 simpul: tempat yang didatangi, ide yang dirawat, orang yang dijaga. Atlas merangkai ketiganya jadi satu konstelasi yang bisa dijelajahi.</p>
      <div class="hero-stats">
        <div><b>42</b><br/><span>Simpul</span></div>
        <div><b>11</b><br/><span>Menara</span></div>
        <div><b>70</b><br/><span>Titik referensi</span></div>
      </div>
    </div>
    <div class="hero-card">
      <div class="cap">Legenda - hover simpul untuk sorot</div>
      <div class="legend">
        <span class="chip"><i style="background:#cf8047"></i> Tempat 14</span>
        <span class="chip"><i style="background:#6aa7ff"></i> Ide 14</span>
        <span class="chip"><i style="background:#4ade80"></i> Orang 14</span>
      </div>
      <div style="display:flex;gap:.5rem;margin-top:.2rem">
        <button class="chip" id="btnShuffle" style="background:#fff;color:#111;cursor:pointer">Acak posisi ↻</button>
        <button class="chip" id="btnFocus" style="background:#0a0a0a;color:#fff;cursor:pointer">Fokus tengah ◎</button>
      </div>
      <div class="bar"><span>Drag untuk menggeser · klik simpul untuk denyut</span><span id="hoverLabel" style="color:#fff">-</span></div>
    </div>
  </div>
</section>

<section id="menara" class="sec shell">
  <div class="sec-head"><span class="dot"></span> Menara - 11 negara sebagai kartu</div>
  <h2 class="s-title">11 menara. 11 cara<br/>mengingat dunia.</h2>
  <p class="s-desc">Tiap menara adalah negara yang dipinjam bentuknya untuk menyimpan memori personal - bukan geopolitik, bukan pasar. Dari pagoda Jepang sampai kuil Kamboja.</p>
  <div class="marq rv" style="margin-top:1.2rem" aria-hidden="true"><div class="marq-track" id="marqTowns"></div></div>
  <div class="towers" id="towers"></div>
</section>

<section id="hidup" class="sec shell" style="border-top:1px solid #e6e5e2">
  <div class="sec-head"><span class="dot"></span> Komponen hidup - ringan, tanpa build</div>
  <h2 class="s-title">Atlas juga punya<br/>alat ukur sendiri.</h2>
  <p class="s-desc">Tiga panel kecil untuk membaca kepadatan jaringan: marquee kota yang terus berjalan, tiga gauge radial, dan bidang partikel yang menolak kursor.</p>
  <div class="hidup">
    <article class="hcard wide rv" data-mod="marq">
      <div class="cap"><b>Marquee - kota yang lewat</b><span>magic/marquee</span></div>
      <div style="padding:1.1rem 0"><div class="marq"><div class="marq-track" id="marqCities"></div></div></div>
      <p class="note" style="border-top:1px solid #e6e5e2">Daftar kota dari 70 titik, diulang tanpa jeda. Arah dibalik tiap kali kartu disentuh.</p>
    </article>
    <article class="hcard rv" data-mod="gauge">
      <div class="cap"><b>Gauge - kepadatan</b><span>gauge-01</span></div>
      <div class="lvs">
        <div class="lv"><canvas class="lv-h" id="lv1" aria-hidden="true"></canvas><div class="lv-n" id="lv1n">-</div><div class="lv-l">Tempat</div></div>
        <div class="lv"><canvas class="lv-h" id="lv2" aria-hidden="true"></canvas><div class="lv-n" id="lv2n">-</div><div class="lv-l">Ide</div></div>
        <div class="lv"><canvas class="lv-h" id="lv3" aria-hidden="true"></canvas><div class="lv-n" id="lv3n">-</div><div class="lv-l">Orang</div></div>
      </div>
      <p class="note" style="border-top:1px solid #e6e5e2">Proporsi tiap kategori, naik pelan saat kartu terlihat. Klik gauge untuk nilai acak.</p>
    </article>
    <article class="hcard rv" data-mod="part">
      <div class="cap"><b>Particles - bidang tolak</b><span>magic/particles</span></div>
      <canvas class="pmin" id="pmin" aria-hidden="true" style="border-top:none"></canvas>
      <p class="note" style="border-top:1px solid #e6e5e2">30 titik saling terhubung di bawah 110px; kursor mendorong mereka menjauh.</p>
    </article>
  </div>
</section>

<section id="alur" class="sec shell" style="background:#f1f0ee;border-radius:2rem">
  <div class="sec-head"><span class="dot"></span> Alur - structure-flow</div>
  <h2 class="s-title">Tempat → Ide → Orang.</h2>
  <p class="s-desc">Garis bukan rute pesawat. Garis adalah alasan: tempat melahirkan ide, ide mempertemukan orang, orang membawa pulang ke tempat baru.</p>
  <div class="flow-wrap">
    <svg class="flow-svg" viewBox="0 0 900 360" role="img" aria-label="Alur koneksi Atlas">
      <defs><linearGradient id="g1" x1="0" y1="0" x2="1" y2="0"><stop stop-color="#cf8047"/><stop offset="1" stop-color="#b15f2c"/></linearGradient></defs>
      <!-- nodes -->
      <g font-family="Onest, sans-serif">
        <!-- col Tempat -->
        <g id="colTempat"><rect x="40" y="28" rx="14" width="210" height="304" fill="#fff" stroke="#e6e5e2"/><text x="145" y="52" text-anchor="middle" font-size="11" font-weight="700" letter-spacing=".08em" fill="#111">TEMPAT</text>
          <g class="fn"><rect x="60" y="68" rx="10" width="170" height="36" fill="#0a0a0a"/><text x="145" y="90" text-anchor="middle" font-size="11" font-weight="600" fill="#fff">Jakarta - Rumah</text></g>
          <g><rect x="60" y="112" rx="10" width="170" height="36" fill="#f1f0ee"/><text x="145" y="134" text-anchor="middle" font-size="11" fill="#111">Kyoto - Jeda</text></g>
          <g><rect x="60" y="156" rx="10" width="170" height="36" fill="#f1f0ee"/><text x="145" y="178" text-anchor="middle" font-size="11" fill="#111">Bali - Napas</text></g>
          <g><rect x="60" y="200" rx="10" width="170" height="36" fill="#f1f0ee"/><text x="145" y="222" text-anchor="middle" font-size="11" fill="#111">Istanbul - Ambang</text></g>
          <g><rect x="60" y="244" rx="10" width="170" height="36" fill="#fff" stroke="#e6e5e2"/><text x="145" y="266" text-anchor="middle" font-size="11" fill="#8d8d8d">+10 tempat lain</text></g>
        </g>
        <!-- col Ide -->
        <g id="colIde"><rect x="345" y="28" rx="14" width="210" height="304" fill="#fff" stroke="#e6e5e2"/><text x="450" y="52" text-anchor="middle" font-size="11" font-weight="700" letter-spacing=".08em" fill="#111">IDE</text>
          <g><rect x="365" y="68" rx="10" width="170" height="36" fill="#ffedd5" stroke="#fed7aa"/><text x="450" y="90" text-anchor="middle" font-size="11" fill="#7c2d12">Ritual Pagi</text></g>
          <g><rect x="365" y="112" rx="10" width="170" height="36" fill="#dbeafe" stroke="#bfdbfe"/><text x="450" y="134" text-anchor="middle" font-size="11" fill="#1e3a5f">Arsip Hidup</text></g>
          <g><rect x="365" y="156" rx="10" width="170" height="36" fill="#dcfce7" stroke="#bbf7d0"/><text x="450" y="178" text-anchor="middle" font-size="11" fill="#14532d">Jalan Pelan</text></g>
          <g><rect x="365" y="200" rx="10" width="170" height="36" fill="#f1f0ee"/><text x="450" y="222" text-anchor="middle" font-size="11" fill="#111">Kota 15 Menit</text></g>
          <g><rect x="365" y="244" rx="10" width="170" height="36" fill="#fff" stroke="#e6e5e2"/><text x="450" y="266" text-anchor="middle" font-size="11" fill="#8d8d8d">+10 ide lain</text></g>
        </g>
        <!-- col Orang -->
        <g id="colOrang"><rect x="650" y="28" rx="14" width="210" height="304" fill="#fff" stroke="#e6e5e2"/><text x="755" y="52" text-anchor="middle" font-size="11" font-weight="700" letter-spacing=".08em" fill="#111">ORANG</text>
          <g><rect x="670" y="68" rx="10" width="170" height="36" fill="#0a0a0a"/><text x="755" y="90" text-anchor="middle" font-size="11" font-weight="600" fill="#fff">Ibu - Kompas</text></g>
          <g><rect x="670" y="112" rx="10" width="170" height="36" fill="#f1f0ee"/><text x="755" y="134" text-anchor="middle" font-size="11" fill="#111">Kawan Studio</text></g>
          <g><rect x="670" y="156" rx="10" width="170" height="36" fill="#f1f0ee"/><text x="755" y="178" text-anchor="middle" font-size="11" fill="#111">Guru Jalan</text></g>
          <g><rect x="670" y="200" rx="10" width="170" height="36" fill="#f1f0ee"/><text x="755" y="222" text-anchor="middle" font-size="11" fill="#111">Tetangga Warung</text></g>
          <g><rect x="670" y="244" rx="10" width="170" height="36" fill="#fff" stroke="#e6e5e2"/><text x="755" y="266" text-anchor="middle" font-size="11" fill="#8d8d8d">+10 orang lain</text></g>
        </g>
      </g>
      <!-- lines -->
      <g fill="none" stroke-linecap="round">
        <path d="M230 86 C 285 86, 290 86, 365 86" stroke="url(#g1)" stroke-width="1.4" stroke-dasharray="6 6" opacity=".9"/>
        <path d="M230 130 C 290 130, 285 130, 365 130" stroke="#9aa0b2" stroke-width="1" opacity=".35"/>
        <path d="M230 174 C 290 150, 285 170, 365 174" stroke="#9aa0b2" stroke-width="1" opacity=".35"/>
        <path d="M555 86 C 610 86, 605 86, 670 86" stroke="url(#g1)" stroke-width="1.4" opacity=".9"/>
        <path d="M555 130 C 610 130, 605 140, 670 130" stroke="#9aa0b2" stroke-width="1" opacity=".35"/>
        <path d="M555 174 C 610 190, 605 170, 670 174" stroke="#9aa0b2" stroke-width="1" opacity=".35"/>
        <path d="M230 218 C 290 240, 400 260, 670 218" stroke="#cf8047" stroke-width="1" opacity=".22"/>
      </g>
      <g fill="#cf8047"><circle cx="365" cy="86" r="3"/><circle cx="670" cy="86" r="3"/></g>
    </svg>
    <div class="flow-legend"><span><i style="background:#cf8047"></i> Alur utama</span><span><i style="background:#9aa0b2"></i> Alur sekunder</span><span>↳ Garis putus = ingatan yang masih dicari</span></div>
  </div>
</section>

<section id="titik" class="sec shell">
  <div class="sec-head"><span class="dot"></span> Titik - 70 referensi personal</div>
  <h2 class="s-title">70 titik untuk kembali.</h2>
  <p class="s-desc">Bukan watchlist. Ini daftar tempat yang pernah singgah, ide yang dipegang, dan orang yang diingat - diringkas jadi 70 untuk bisa dibawa.</p>
  <div class="points-head">
    <button class="filter on" data-f="all">Semua 70</button>
    <button class="filter" data-f="tempat">Tempat 25</button>
    <button class="filter" data-f="ide">Ide 20</button>
    <button class="filter" data-f="orang">Orang 25</button>
  </div>
  <div class="points" id="points"></div>
  <p style="margin-top:1rem;font-size:.74rem;color:#595959">Sumber: catatan harian, foto, dan percakapan 2020–2025. Disusun manual, diperbarui tiap musim.</p>
</section>

<section id="tentang" class="sec shell" style="border-top:1px solid #e6e5e2">
  <div class="tentang-grid">
    <div>
      <div class="sec-head"><span class="dot"></span> Tentang Atlas</div>
      <h2 class="s-title" style="max-width:18ch">Atlas bukan peta<br/>untuk menang.</h2>
      <p class="s-desc">Atlas adalah kebalikan dari dashboard trading. Tidak ada candle, tidak ada sinyal beli. Hanya simpul yang saling menarik pelan - seperti konstelasi yang baru terlihat setelah mata terbiasa gelap.</p>
      <ul style="margin-top:1rem;display:flex;flex-direction:column;gap:.5rem;font-size:.88rem;color:rgba(17,17,17,.7)">
        <li>• Dibuat single-file, tanpa build - buka langsung jalan.</li>
        <li>• 42 simpul di canvas, 11 menara, 70 titik - angka yang sengaja dibatasi.</li>
        <li>• Struktur meniru <b>lumora.html</b> tapi isinya personal.</li>
      </ul>
    </div>
    <div class="orbit-card rv">
      <div class="orbit-stage" id="orbitStage" role="img" aria-label="Tiga kategori Atlas mengorbit satu inti">
        <div class="orbit-core">42</div>
        <div class="orbit-ring" id="orbitRing1"></div>
        <div class="orbit-ring" id="orbitRing2"></div>
      </div>
      <p style="font-size:.72rem;line-height:1.55;color:#595959;text-align:center">Tempat · Ide · Orang mengorbit satu inti. Dua cincin, arah berlawanan - seperti konstelasi yang pelan.</p>
    </div>
  </div>
</section>
</main>

<footer id="contact">
  <div class="footer-cta">
    <div><div class="eyebrow light"><span class="dot"></span> Mulai pakai</div><h2 style="margin-top:1rem"><span class="clip"><span>Siap baca</span></span><br><span class="clip"><span>pasar?</span></span></h2></div>
    <button class="pill light" id="footerCta">Atur Notifikasi <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
  </div>
  <div class="footer-cols">
    <div class="footer-brand"><div class="footer-brand-title" translate="no"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3" fill="currentColor" stroke="none"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3"/></svg> AIOS · Atlas</div><p style="margin-top:1rem;font-size:.875rem;color:rgba(255,255,255,.65)">Bukti ditulis, rencana ditahan, alasan disimpan. Bukan sinyal.</p><address style="margin-top:1.5rem;font-style:normal;font-size:.875rem;color:rgba(255,255,255,.8)"><a href="mailto:hello@aios.app">hello@aios.app</a></address></div>
    <div><p class="mono-s" style="margin-bottom:.9rem">Halaman</p><ul style="font-size:.875rem;color:rgba(255,255,255,.7);display:grid;gap:.55rem"><li><a href="/atrium">Atrium</a></li><li><a href="/arc">Arc</a></li><li><a href="/materi">Materi</a></li><li><a href="/jejak">Jejak</a></li><li><a href="/ikhtisar">Ikhtisar</a></li></ul></div>
    <div><p class="mono-s" style="margin-bottom:.9rem">Data</p><ul style="font-size:.875rem;color:rgba(255,255,255,.7);display:grid;gap:.55rem"><li>70 snapshot</li><li>5 brief keputusan</li><li>1 jendela aktif</li><li>3 posisi ditutup</li></ul></div>
  </div>
  <div style="border-top:1px solid rgba(255,255,255,.15);margin-top:2.5rem;padding-top:1.5rem;display:flex;flex-wrap:wrap;gap:1rem;justify-content:space-between;font-size:.75rem;color:rgba(255,255,255,.6)"><p>© 2026 AIOS</p><p>Phase H · 24 Agt - 23 Sep 2026 · Asia/Jakarta</p></div>
</footer>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/atlas.js");
            await module.InvokeVoidAsync("initAtlas");
        }
    }
}
