    private async Task ExportToCsv<T>(List<T> data, string filename)
    {
        using var writer = new System.IO.StringWriter();
        using var csv = new CsvHelper.CsvWriter(writer, System.Globalization.CultureInfo.InvariantCulture);
        csv.WriteRecords(data);
        var csvContent = writer.ToString();
        var bytes = System.Text.Encoding.UTF8.GetBytes(csvContent);
        await JSRuntime.InvokeVoidAsync("downloadFile", filename, Convert.ToBase64String(bytes), "text/csv");
    }

    private async Task ExportToMarkdown<T>(List<T> data, string filename, params (string Header, Func<T, string> Selector)[] columns)
    {
        using var writer = new System.IO.StringWriter();
        // Header
        writer.Write("| " + string.Join(" | ", columns.Select(c => c.Header)) + " |");
        writer.WriteLine();
        writer.Write("| " + string.Join(" | ", columns.Select(_ => "---")) + " |");
        writer.WriteLine();
        
        foreach (var item in data)
        {
            writer.Write("| " + string.Join(" | ", columns.Select(c => c.Selector(item))) + " |");
            writer.WriteLine();
        }
        
        var mdContent = writer.ToString();
        var bytes = System.Text.Encoding.UTF8.GetBytes(mdContent);
        await JSRuntime.InvokeVoidAsync("downloadFile", filename, Convert.ToBase64String(bytes), "text/markdown");
    }

    [Inject] public IJSRuntime JSRuntime { get; set; } = default!;

    // Phase 4b: Equity chart rendering
    private async Task RenderEquityChartAsync()
    {
        if (Trades.Count == 0 && Positions.Count == 0)
            return;

        // Use positions for equity curve - realized P&L from closed positions
        var closedPositions = Positions.Where(p => p.Status == "CLOSED" && p.RealizedPnl != 0)
            .OrderBy(p => p.CreatedAt)
            .ToList();

        var labels = new List<string>();
        var equityData = new List<double>();
        double cumulativeEquity = 0;

        foreach (var pos in closedPositions)
        {
            if (DateTime.TryParse(pos.CreatedAt, out var dt))
            {
                labels.Add(dt.ToString("yyyy-MM-dd HH:mm"));
                cumulativeEquity += pos.RealizedPnl;
                equityData.Add(cumulativeEquity);
            }
        }

        // If no closed positions, fall back to trades
        if (labels.Count == 0 && Trades.Count > 0)
        {
            var sortedTrades = Trades.OrderBy(t => t.ExecutedAt).ToList();
            
            foreach (var trade in sortedTrades)
            {
                if (DateTime.TryParse(trade.ExecutedAt, out var dt))
                {
                    labels.Add(dt.ToString("yyyy-MM-dd HH:mm"));
                    // Simplified P&L per trade (sell - buy) - this is a proxy since we don't have matched fills
                    double tradePnl = (trade.Action == "SELL" ? 1 : -1) * trade.FillPrice * trade.Quantity - trade.Fee - trade.Tax;
                    cumulativeEquity += tradePnl;
                    equityData.Add(cumulativeEquity);
                }
            }
        }

        if (labels.Count == 0)
            return;

        var datasets = new[]
        {
            new { label = "Cumulative Equity (Realized P&L)", data = equityData, borderColor = "rgb(54, 162, 235)", backgroundColor = "rgba(54, 162, 235, 0.1)", fill = true, tension = 0.1 }
        };

        await JSRuntime.InvokeVoidAsync("renderEquityChart", "equityChart", labels, datasets);
    }
