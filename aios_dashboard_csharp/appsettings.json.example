{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DashboardAuth": {
    "Username": "your-username",
    "PasswordHash": "$2a$11$EXAMPLE_BCRYPT_HASH_REPLACE_ME",
    "SessionTimeoutMinutes": 60
  },
  "ConnectionStrings": {
    "Default": "path/to/investment_platform.db"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      }
    }
  }
}
